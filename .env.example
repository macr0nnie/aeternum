# Supabase
# ── ALPHA / remote users: use the CLOUD project (works on any device anywhere) ──
#   EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon public key from Dashboard → Settings → API>
#   Requires: `supabase link` + `supabase db push` + `supabase config push`,
#   and Anonymous sign-ins ON in Dashboard → Authentication → Providers.
#
# ── LOCAL only (Docker `supabase start`, same machine/Wi-Fi) ──
#   - Physical device on same Wi-Fi:  http://<your-machine-LAN-IP>:54321
#   - Android emulator:               http://10.0.2.2:54321
#   - iOS simulator:                  http://localhost:54321
# Cleartext HTTP to local Supabase is enabled via expo-build-properties
# (android.usesCleartextTraffic). Keep it true so one build hits both local + cloud;
# set it false for a pure-cloud (https-only) production release.
#
# If these are left blank or at the placeholder, the app boots in offline mode
# (fully navigable, progress kept on-device only).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Firebase — get from google-services.json (Analytics + FCM)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id

# Sentry crash reporting (optional). Leave blank to keep Sentry inert + fall back
# to local logging. Get the DSN from your Sentry project settings.
EXPO_PUBLIC_SENTRY_DSN=
